<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Redis-based distributed coordinator for ModularPipelines, built on the Respire client. Enables multi-process and multi-machine pipeline execution using Redis for coordination.</Description>
    <!-- Keep this integration beta: ConfigureConnection intentionally exposes pre-1.0 Respire APIs. -->
    <VersionSuffix>beta</VersionSuffix>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularPipelines\ModularPipelines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kevlar" />
    <PackageReference Include="Respire" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ModularPipelines.Distributed.Redis.UnitTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
