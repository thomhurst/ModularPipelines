    <!--#if (tests)-->
    <PackageVersion Include="ModularPipelines.Testing" Version="__MODULAR_PIPELINES_VERSION__" />
    <PackageVersion Include="TUnit" Version="1.76.28" />
    <!--#endif-->
  </ItemGroup>
</Project>
