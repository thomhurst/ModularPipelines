<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\ModularPipelines\ModularPipelines.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\ModularPipelines.TestHelpers\ModularPipelines.TestHelpers.csproj" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)GeneratedOptionsSmokeTests.targets" />
</Project>
