<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="TUnit" />
  </ItemGroup>
  <!--
    This project hosts GeneratedCliRenderingSnapshotTests, which reflects over the generated
    options of EVERY tool integration, so it necessarily references them all. It is deliberately
    kept to just that one snapshot test: referencing all integrations from the large, multi-file
    core test project made it a single oversized compilation unit that stalled the CI runner
    (#3179). A single-file project keeps the compile cheap while still giving the snapshot test
    every package assembly in its output directory. It must NOT contain pipeline-building tests:
    the snapshot test loads packages into collectible load contexts and unloads them, which would
    corrupt assembly resolution for any pipeline built afterwards in the same process.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ModularPipelines.AmazonWebServices\ModularPipelines.AmazonWebServices.csproj" />
    <ProjectReference Include="..\..\src\ModularPipelines.Ansible\ModularPipelines.Ansible.csproj" />
