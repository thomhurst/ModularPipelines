<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularPipelines.OptionsGenerator\ModularPipelines.OptionsGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../src/ModularPipelines.AmazonWebServices/Extensions/AmazonExtensions.cs"
             Link="Fixtures/AmazonExtensions.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Compile the production renderer directly; the generator already links its shared phase/arity enums. -->
  <ItemGroup>
    <!-- Copy production sources as text so the test can compile isolated consumers against either contract namespace. -->
    <Content Include="../../../../src/ModularPipelines/Models/KeyValue.cs;
                      ../../../../src/ModularPipelines/Models/CliOptionValue.cs;
                      ../../../../src/ModularPipelines/Models/CliValuePair.cs;
                      ../../../../src/ModularPipelines/Models/CliValueGroup.cs;
                      ../../../../src/ModularPipelines/Helpers/Internal/CommandArgumentBuilder.cs;
                      ../../../../src/ModularPipelines/Helpers/Internal/ICommandArgumentBuilder.cs;
                      ../../../../src/ModularPipelines/Generated/PropertyCommandLinePart.cs;
                      ../../../../src/ModularPipelines/Attributes/CliArgumentAttribute.cs;
                      ../../../../src/ModularPipelines/Attributes/CliOptionAttribute.cs;
                      ../../../../src/ModularPipelines/Attributes/CliFlagAttribute.cs;
                      ../../../../src/ModularPipelines/Attributes/EnumValueAttribute.cs;
                      ../../../../src/ModularPipelines/Attributes/OptionFormat.cs;
                      ../../../../src/ModularPipelines/Attributes/CommandLinePhase.cs;
                      ../../../../src/ModularPipelines/Attributes/CliOptionValueArity.cs"
             Link="Fixtures/NamespaceRuntime/%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../../src/ModularPipelines/Attributes/CliArgumentAttribute.cs" Link="Runtime/Attributes/CliArgumentAttribute.cs" />
    <Compile Include="../../../../src/ModularPipelines/Attributes/CliFlagAttribute.cs" Link="Runtime/Attributes/CliFlagAttribute.cs" />
    <Compile Include="../../../../src/ModularPipelines/Attributes/CliOptionAttribute.cs" Link="Runtime/Attributes/CliOptionAttribute.cs" />
    <Compile Include="../../../../src/ModularPipelines/Attributes/EnumValueAttribute.cs" Link="Runtime/Attributes/EnumValueAttribute.cs" />
    <Compile Include="../../../../src/ModularPipelines/Attributes/OptionFormat.cs" Link="Runtime/Attributes/OptionFormat.cs" />
    <Compile Include="../../../../src/ModularPipelines/Generated/PropertyCommandLinePart.cs" Link="Runtime/Generated/PropertyCommandLinePart.cs" />
    <Compile Include="../../../../src/ModularPipelines/Helpers/Internal/CommandArgumentBuilder.cs" Link="Runtime/Helpers/Internal/CommandArgumentBuilder.cs" />
    <Compile Include="../../../../src/ModularPipelines/Helpers/Internal/ICommandArgumentBuilder.cs" Link="Runtime/Helpers/Internal/ICommandArgumentBuilder.cs" />
    <Compile Include="../../../../src/ModularPipelines/Models/CliOptionValue.cs" Link="Runtime/Models/CliOptionValue.cs" />
    <Compile Include="../../../../src/ModularPipelines/Models/CliValuePair.cs" Link="Runtime/Models/CliValuePair.cs" />
    <Compile Include="../../../../src/ModularPipelines/Models/CliValueGroup.cs" Link="Runtime/Models/CliValueGroup.cs" />
    <Compile Include="../../../../src/ModularPipelines/Models/KeyValue.cs" Link="Runtime/Models/KeyValue.cs" />
  </ItemGroup>

</Project>
