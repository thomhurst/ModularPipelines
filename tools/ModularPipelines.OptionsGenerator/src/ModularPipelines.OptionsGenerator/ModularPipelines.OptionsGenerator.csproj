<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>modular-pipelines-options</ToolCommandName>
    <PackageId>ModularPipelines.OptionsGenerator</PackageId>
    <Description>Generates strongly typed ModularPipelines integrations from CLI metadata.</Description>
    <PackageTags>ModularPipelines CLI code-generation dotnet-tool</PackageTags>
    <!-- Microsoft.Playwright ships helper scripts inside the self-contained tool package. -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Polly" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TypeOverrides\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModularPipelines.OptionsGenerator.Tests" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)..\..\..\..\src\ModularPipelines.SourceGenerator\ModularPipelines.SourceGenerator.csproj" />
    <Compile Include="..\..\..\..\src\ModularPipelines\Attributes\CliOptionValueArity.cs" Link="Shared\CliOptionValueArity.cs" />
    <Compile Include="..\..\..\..\src\ModularPipelines\Attributes\CommandLinePhase.cs" Link="Shared\CommandLinePhase.cs" />
    <Compile Include="..\..\..\..\src\ModularPipelines\Helpers\Internal\WindowsCommandResolver.cs" Link="Shared\WindowsCommandResolver.cs" />
    <Compile Include="..\..\..\..\src\ModularPipelines\Options\AdditionalCommandLineArgument.cs" Link="Shared\AdditionalCommandLineArgument.cs" />
    <Compile Include="..\..\..\..\src\ModularPipelines\Options\CommandLineToolOptions.cs" Link="Shared\CommandLineToolOptions.cs" />
  </ItemGroup>

</Project>
